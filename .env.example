# EmailJS (https://dashboard.emailjs.com) — copy to .env.local and fill in.
# Service ID:  Email Services → your service
# Template ID: Email Templates → your template (uses {{fullName}}, {{phoneNumber}}, {{email}}, {{message}})
# Public key:  Account → General → Public Key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
